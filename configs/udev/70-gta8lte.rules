# Unisoc UMS512 / Samsung Galaxy Tab A8 (SM-X205) udev permissions
KERNEL=="mali0", MODE="0666"
KERNEL=="ion", MODE="0666"
KERNEL=="gsp", MODE="0666"
KERNEL=="pvr_sync", MODE="0666"
KERNEL=="sw_sync", MODE="0666"
SUBSYSTEM=="drm", KERNEL=="card*", MODE="0666"
SUBSYSTEM=="drm", KERNEL=="renderD*", MODE="0666"
KERNEL=="binder", MODE="0666"
KERNEL=="hwbinder", MODE="0666"
KERNEL=="vndbinder", MODE="0666"
KERNEL=="anbox-binder", MODE="0666"
KERNEL=="anbox-hwbinder", MODE="0666"
KERNEL=="anbox-vndbinder", MODE="0666"
KERNEL=="ashmem", MODE="0666"
KERNEL=="sprd_*", MODE="0666"
KERNEL=="audio_dsp*", MODE="0666"
KERNEL=="audio_pipe*", MODE="0666"
KERNEL=="apipe-*", MODE="0666"
KERNEL=="ttyBT*", MODE="0666"
KERNEL=="sttybt*", MODE="0666"
KERNEL=="slog_wcn*", MODE="0666"
KERNEL=="wcn*", MODE="0666"
SUBSYSTEM=="backlight", KERNEL=="sprd_backlight", ACTION=="add", RUN+="/bin/chmod 0666 /sys/class/backlight/%k/brightness"
